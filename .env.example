# Safe example config for NovelWriter Agent.
# Copy this file to .env for local use. Never commit your real .env file.
#
# OpenAI-compatible API configuration.
# Leave OPENAI_API_KEY empty and keep NOVELWRITER_MOCK=true to run locally without a model.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# true: use deterministic mock output; false: call the configured OpenAI-compatible model.
NOVELWRITER_MOCK=true

# Optional generation settings.
NOVELWRITER_TEMPERATURE=0.8
NOVELWRITER_MAX_TOKENS=4096
